<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing is copied to cloud backup or to a new device. The app will hold an auth
    session and personal usage history; a fresh install signs in again and re-syncs instead.
    Phase 8 revisits this if settings should carry over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
